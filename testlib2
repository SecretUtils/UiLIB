			function library:watermark(options)
				options = options or {}

				local cfg = {
					name = options.name or options.title or "fem.hook",
					default = options.text or options.default,
					logo = options.logo,
				}

				local watermark_outline = library:create("Frame", {
					Parent = sgui,
					Name = "",
					BorderColor3 = rgb(0, 0, 0),
					AnchorPoint = vec2(0, 0),
					--// MUST be pure offset - no Scale. library:draggify reads Position.X.Offset
					--// and writes back dim2(0, x, 0, y), so any Scale component is silently
					--// dropped on the first drag and the bar teleports across the screen.
					Position = dim_offset(max(0, camera.ViewportSize.X - 260), 20),
					Size = dim2(0, 0, 0, 24),
					BorderSizePixel = 0,
					AutomaticSize = Enum.AutomaticSize.X,
					BackgroundColor3 = themes.preset.outline
				}) library:apply_theme(watermark_outline, "outline", "BackgroundColor3")
				library:draggify(watermark_outline, "watermark")

				--// the glow CANNOT be a child of watermark_outline: that frame is
				--// AutomaticSize.X and a (1, spread*2) child would feed its own width back in
				--// and run the bar to the screen edge. so it lives in sgui as a sibling and
				--// tracks the bar's absolute rect instead.
				cfg.glow = library:apply_glow(sgui, {zindex = 0, manual = true})
				local function sync_watermark_glow()
					local sp = library.glow_size
					--// mirror Position, NOT AbsolutePosition. both frames live in the same
					--// (IgnoreGuiInset) ScreenGui, so copying the UDim2 verbatim keeps them in
					--// one coordinate space - reading Absolute* and writing Position mixes two
					--// and leaves the glow floating off the bar by the gui inset.
					local p = watermark_outline.Position
					local s = watermark_outline.AbsoluteSize
					cfg.glow.Position = dim2(p.X.Scale, p.X.Offset - sp, p.Y.Scale, p.Y.Offset - sp)
					cfg.glow.Size = dim2(0, s.X + sp * 2, 0, s.Y + sp * 2)
					cfg.glow.Visible = watermark_outline.Visible
				end
				library:connection(watermark_outline:GetPropertyChangedSignal("AbsoluteSize"), sync_watermark_glow)
				library:connection(watermark_outline:GetPropertyChangedSignal("Position"), sync_watermark_glow)
				library:connection(watermark_outline:GetPropertyChangedSignal("Visible"), sync_watermark_glow)
				insert(library.glow_hooks, sync_watermark_glow)
				sync_watermark_glow()

				--// AutomaticSize.X means the width isn't measured until layout has run, so
				--// park it top-right on the next frame. anchor stays (0,0) so draggify and
				--// the saved ui_positions restore both use plain top-left offsets.
				task.spawn(function()
					task.wait()
					local saved = flags["ui_positions"]
					if type(saved) == "table" and saved["watermark"] then return end
					local w = watermark_outline.AbsoluteSize.X
					local vp = camera.ViewportSize
					watermark_outline.Position = dim_offset(max(0, vp.X - w - 20), 20)
				end)

				local watermark_inline = library:create("Frame", {
					Parent = watermark_outline,
					Name = "",
					Position = dim2(0, 1, 0, 1),
					BorderColor3 = rgb(0, 0, 0),
					Size = dim2(1, -2, 1, -2),
					BorderSizePixel = 0,
					BackgroundColor3 = themes.preset.inline
				}) library:apply_theme(watermark_inline, "inline", "BackgroundColor3")

				local watermark_background = library:create("Frame", {
					Parent = watermark_inline,
					Name = "",
					Position = dim2(0, 1, 0, 1),
					BorderColor3 = rgb(0, 0, 0),
					Size = dim2(1, -2, 1, -2),
					BorderSizePixel = 0,
					BackgroundColor3 = rgb(255, 255, 255)
				})

				local UIGradient = library:create("UIGradient", {
					Parent = watermark_background,
					Name = "",
					Rotation = 90,
					Color = rgbseq{
						rgbkey(0, rgb(41, 41, 55)),
						rgbkey(1, rgb(35, 35, 47))
					}
				}) library:apply_theme(UIGradient, "contrast", "Color")

				local text_offset = 4

				if cfg.logo then
					library:create("ImageLabel", {
						Parent = watermark_background,
						Name = "",
						Image = cfg.logo,
						BackgroundTransparency = 1,
						BorderColor3 = rgb(0, 0, 0),
						BorderSizePixel = 0,
						ScaleType = Enum.ScaleType.Fit,
						AnchorPoint = vec2(0, 0.5),
						Position = dim2(0, 4, 0.5, 0),
						Size = dim2(0, 14, 0, 14),
						ZIndex = 2,
						BackgroundColor3 = rgb(255, 255, 255)
					})

					text_offset = 18
				end

				local text = library:create("TextLabel", {
					Parent = watermark_background,
					Name = "",
					FontFace = library.font,
					RichText = true,
					TextColor3 = themes.preset.text,
					BorderColor3 = rgb(0, 0, 0),
					Text = "",
					AnchorPoint = vec2(0, 0.5),
					Size = dim2(0, 0, 0, 15),
					BackgroundTransparency = 1,
					Position = dim2(0, text_offset, 0.5, 1),
					BorderSizePixel = 0,
					AutomaticSize = Enum.AutomaticSize.X,
					TextSize = 12,
					ZIndex = 2,
					BackgroundColor3 = rgb(255, 255, 255)
				})

				library:create("UIStroke", {
					Parent = text,
					Name = "",
					LineJoinMode = Enum.LineJoinMode.Miter
				})

				--// NOTE: these liners must sit on watermark_outline with a NEGATIVE offset
				--// (1, -4), not on watermark_background at (1, 0). the outline is
				--// AutomaticSize.X; a full-width scale child feeds the measured width back
				--// into the auto-size and the bar runs out to the viewport edge.
				local accent = library:create("Frame", {
					Parent = watermark_outline,
					Name = "",
					Position = dim2(0, 2, 0, 2),
					BorderColor3 = rgb(0, 0, 0),
					Size = dim2(1, -4, 0, 2),
					ZIndex = 3,
					BorderSizePixel = 0,
					BackgroundColor3 = themes.preset.accent
				}) library:apply_theme(accent, "accent", "BackgroundColor3")

				local accent_shine = library:create("UIGradient", {
					Parent = accent,
					Name = "",
					Rotation = 0,
					Offset = vec2(0, 0),
					Transparency = numseq{
						numkey(0,   0),
						numkey(0.5, 1),
						numkey(1,   0)
					}
				})

				local dark_liner = library:create("Frame", {
					Parent = watermark_outline,
					Name = "",
					Position = dim2(0, 2, 0, 4),
					BorderColor3 = rgb(0, 0, 0),
					Size = dim2(1, -4, 0, 1),
					ZIndex = 3,
					BorderSizePixel = 0,
					BackgroundColor3 = themes.preset.low_contrast
				}) library:apply_theme(dark_liner, "low_contrast", "BackgroundColor3")

				local plain_text = cfg.default or cfg.name
				local provider, provider_tick = nil, 0
				local frames, fps, fps_tick = 0, 0, tick()

				function cfg.change_text(input)
					provider = nil
					plain_text = tostring(input or "")
					text.Text = "  " .. plain_text .. "  "
				end

				function cfg.set_name(input)
					cfg.name = tostring(input or "")
				end

				function cfg.set_dynamic_text(callback)
					provider = (type(callback) == "function") and callback or nil
					provider_tick = 0
				end

				function cfg.get_fps()
					return fps
				end

				function cfg.set_visible(bool)
					watermark_outline.Visible = bool
				end

				do
					local phase, last, shine_width = 0, tick(), 6
					library:connection(run.RenderStepped, function()
						local now = tick()

						frames += 1
						if now - fps_tick >= 1 then
							fps, frames, fps_tick = frames, 0, now
						end

						if not watermark_outline.Visible then return end
						--// Animation Frequency caps this per-frame effect (was a hardcoded 30hz)
						if now - last < (1 / math.clamp(library.animation.frequency or 60, 15, 240)) then return end
						phase = (phase + (now - last) * (1 / 1.2)) % 1
						last = now

						if provider and (now - provider_tick) >= 0.25 then
							provider_tick = now
							local ok, result = pcall(provider, fps)
							if ok then plain_text = tostring(result or "") end
						end

						local body      = "  " .. plain_text .. "  "
						local shine_pos = phase * (#body + shine_width)
						local text_col  = themes.preset.text
						local accent_col= themes.preset.accent
						local rich = {}
						for i = 1, #body do
							local dist = math.abs(i - shine_pos)
							local a    = math.clamp(1 - (dist / shine_width), 0, 1)
							local c    = text_col:Lerp(accent_col, a)
							rich[i] = string.format('<font color="rgb(%d,%d,%d)">%s</font>',
								math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255),
								body:sub(i, i))
						end
						text.Text = table.concat(rich)
						accent_shine.Offset = vec2((phase * 2) - 1, 0)
					end)
				end

				if cfg.default then
					cfg.change_text(cfg.default)
				else
					cfg.set_dynamic_text(function(frame_rate)
						return string.format("%s | %dfps | %s", cfg.name, frame_rate, os.date("%X"))
					end)
					text.Text = "  " .. plain_text .. "  "
				end

				return cfg

			end

			function library:esp_preview(properties)
				local cfg = {items = {}, rotation = 0; objects = {};}

				local function cflag(n)
					if cfg._ctx == "ai" then
						local a = "AI_" .. n
						if flags[a] ~= nil then return a end
					end
					return n
				end
				local function cmaster()
					if cfg._ctx == "ai" then return flags["ESP_AI"] end
					return flags["Enabled"]
				end

				local character = nil
				if lp.Character then
					lp.Character.Archivable = true
					character = lp.Character:Clone()
					character.Animate:Destroy()
				end

				local items = cfg.items; do
					items.viewportframe = library:create( "ViewportFrame" , {
						Parent = self.holder;
						BackgroundTransparency = 1;
						ClipsDescendants = true;
						Size = dim2(1, 0, 0, 220);
						BorderColor3 = rgb(0, 0, 0);
						ZIndex = 1;
						Position = dim2(0, 0, 0, 10);
						BorderSizePixel = 0;
						BackgroundColor3 = rgb(255, 255, 255)
					});

					items.camera = library:create( "Camera" , {
						FieldOfView = 70.00022888183594;
						CameraType = Enum.CameraType.Track;
						Focus = cfr(0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1);
						CFrame = cfr(0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1);
						Parent = ws;
						Name = "\0"
					});

					items.viewportframe.CurrentCamera = items.camera

					if character then
						character.Parent = items.viewportframe
						items.camera.CameraSubject = character
					end

					local FRONT = 180
					cfg.rotation = FRONT
					cfg.target_rotation = FRONT
					cfg.pitch = 0
					cfg.target_pitch = 0
					local dragging, drag_start_x, drag_start_rot = false, 0, FRONT
					local drag_start_y, drag_start_pitch = 0, 0

					items.viewportframe.Active = true
					library:connection(items.viewportframe.InputBegan, function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1
							or input.UserInputType == Enum.UserInputType.Touch then
							dragging = true
							drag_start_x = input.Position.X
							drag_start_rot = cfg.rotation
							drag_start_y = input.Position.Y
							drag_start_pitch = cfg.pitch
						end
					end)
					library:connection(uis.InputChanged, function(input)
						if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
							or input.UserInputType == Enum.UserInputType.Touch) then
							cfg.rotation = drag_start_rot + (input.Position.X - drag_start_x) * 0.6
							cfg.target_rotation = cfg.rotation
							cfg.pitch = math.clamp(drag_start_pitch + (input.Position.Y - drag_start_y) * 0.6, -85, 85)
							cfg.target_pitch = cfg.pitch
						end
					end)
					library:connection(uis.InputEnded, function(input)
						if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
							or input.UserInputType == Enum.UserInputType.Touch) then
