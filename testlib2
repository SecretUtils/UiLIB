							refresh_side_offsets()
							refresh_palette(); save_layout(); sync_real_flag(key, false)
							if cfg.refresh_elements then pcall(cfg.refresh_elements) end
							return
						end
						if GLOBAL_KEYS[key] then
							placed[key] = nil; cfg._show[key] = false
							refresh_palette(); save_layout(); sync_real_flag(key, false)
							if cfg.refresh_elements then pcall(cfg.refresh_elements) end
							return
						end
						local side = placed[key]
						objects[key].Parent = library.cache
