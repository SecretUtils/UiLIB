				cfg.change_health = function()
					if flags[ "healthbar_holder" ] and flags[ "healthbar_holder" ].Parent ~= objects[ "holder" ] then
						return
					end
					if not (character and character:FindFirstChild("Humanoid")) then return end

					local humanoid = character.Humanoid

					local multiplier = humanoid.MaxHealth * math.abs(math.sin(tick() * 2)) / humanoid.MaxHealth
					local lowf  = flags[cflag("Health_Low")]
					local highf = flags[cflag("Health_High")]
					local color = rgb(255, 255, 255)
					if lowf and lowf.Color and highf and highf.Color then
						color = lowf.Color:Lerp(highf.Color, multiplier)
					end

					if cfg._bar_horiz and cfg._bar_horiz.healthbar then
						objects[ "healthbar" ].Size = UDim2.new(multiplier, -2, 1, -2)
						objects[ "healthbar" ].Position = UDim2.new(0, 1, 0, 1)
					else
						objects[ "healthbar" ].Size = UDim2.new(1, -2, multiplier, -2)
						objects[ "healthbar" ].Position = UDim2.new(0, 1, 1 - multiplier, 1)
					end
					objects[ "healthbar" ].BackgroundColor3 = color

					objects[ "hp_number" ].Text = tostring(math.floor(multiplier * humanoid.MaxHealth + 0.5))
				end

				function cfg.refresh_elements( )
					objects.holder.Parent = cmaster() and items.viewportframe or library.cache

					local temp = {
						["Names"] = objects["name"];
						["Name_Color"] = {objects["name"]};
						["Distance"] = objects[ "distance" ];
						["Weapon"] = objects[ "weapon" ];
						["Distance_Color"] = {objects[ "distance" ]};
						["Weapon_Color"] = {objects[ "weapon" ]};
						["HP_Text"] = objects[ "hp_number" ];
						["HP_Text_Color"] = {objects[ "hp_number" ]};
						["ESP_KD"] = objects[ "kd" ];
						["ESP_KD_Color"] = {objects[ "kd" ]};
					}

					for flag,object in temp do
						local v = flags[cflag(flag)]
						if v ~= nil then
							if type(object) == "table" then
								if v.Color then object[1].TextColor3 = v.Color end
							elseif cfg._chip_set and cfg._chip_set[object] then
							else
								object.Parent = v and objects[ "holder" ] or library.cache
							end
						end
					end

					local bt = flags[cflag("Box_Type")]
					local is_corner = (bt == nil) or (bt == "Corner")

					local box_on
					if cfg._show then box_on = cfg._show.box == true else box_on = flags[cflag("Boxes")] == true end

					if box_on then
						objects[ "corners" ].ZIndex = 2
						objects[ "box_handler" ].ZIndex = 2
						if is_corner then
							objects[ "corners" ].Parent = objects["holder"]
							objects[ "box_handler" ].Parent = library.cache
							objects[ "box_outline" ].Parent = library.cache
						else
							objects[ "box_handler" ].Parent = objects[ "holder" ]
							objects[ "box_outline" ].Parent = objects[ "holder" ]
							objects[ "corners" ].Parent = library.cache
						end
					else
						objects[ "corners" ].Parent =  library.cache
						objects[ "box_handler" ].Parent = library.cache
						objects[ "box_outline" ].Parent = library.cache
					end

					do
						local bc  = flags[cflag("Box_Color")]
						local bc2 = flags[cflag("Box_Color_2")]
						objects[ "box_color" ].Thickness =
							math.clamp(tonumber(flags[cflag("box_stroke_thickness")]) or 1, 1, 5)
						if bc and bc.Color then
							objects[ "box_color" ].Color = bc.Color
							local top_col = bc.Color
							local bot_col = (bc2 and bc2.Color) or rgb(0, 0, 0)
							for _, corner in objects[ "corners" ]:GetChildren() do
								local inner = corner:FindFirstChildOfClass("Frame")
								if inner then
									inner.BackgroundColor3 =
										(corner.Position.Y.Scale >= 1) and bot_col or top_col
								end
							end
						end
					end

					do
						local hp_on
						if cfg._show then hp_on = cfg._show.healthbar == true else hp_on = flags[cflag("Healthbar")] == true end
						objects["healthbar_holder"].Parent = hp_on and objects["holder"] or library.cache
					end

					if objects["edition"] then
						local ec = flags[cflag("ESP_Edition_Elite")]
						if ec and ec.Color then objects["edition"].TextColor3 = ec.Color end
					end

					do
						local sel = flags[cflag("ESP_Status_Sel")]
						local set = {}
						if type(sel) == "table" then for _, v in ipairs(sel) do set[v] = true end
						elseif type(sel) == "string" then set[sel] = true end
						local status_map = {
							{"vis",     "Visible", "ESP_Vis_Color"},
							{"manip",   "Manip",   "ESP_Manip_Color"},
							{"reload",  "Reload",  "ESP_Reload_Color"},
							{"exiting", "Exiting", "ESP_Exit_Color"},
							{"combat",  "Combat",  "ESP_Combat_Color"},
							{"bleeding", "Bleeding", "ESP_Bleed_Color"},
							{"stims",   "Stims",   "ESP_Stim_Color"},
							{"looting", "Looting", "ESP_Loot_Color"},
							{"lookat",  "LookAt",  "ESP_LookAt_Color"},
						}
						for _, s in ipairs(status_map) do
							local obj = objects[s[1]]
							if obj then
								local c = flags[cflag(s[3])]
								if c and c.Color then obj.TextColor3 = c.Color end
							end
						end
					end

					if objects["ammo_bg"] then
						local ammo_on
						if cfg._show then ammo_on = cfg._show.ammo == true else ammo_on = flags[cflag("Ammobar")] == true end
						objects["ammo_bg"].Parent = ammo_on and objects["holder"] or library.cache
						local bg = flags[cflag("Ammo_BG_Color")]
						if bg and bg.Color then objects["ammo_bg"].BackgroundColor3 = bg.Color end
						local c1, c2 = flags[cflag("Ammo_Color_Top")], flags[cflag("Ammo_Color_Bottom")]
						if objects["ammo_grad"] and c1 and c2 and c1.Color and c2.Color then
							objects["ammo_grad"].Color = ColorSequence.new(c1.Color, c2.Color)
						end
					end
				end

