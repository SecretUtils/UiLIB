							cfg.target_rotation = FRONT
							cfg.target_pitch = 0
						end
					end)

					local function vp_project(world_pos)
						local cam = items.camera
						local vp = items.viewportframe.AbsoluteSize
						if vp.X <= 0 or vp.Y <= 0 then return nil end
						local rel = cam.CFrame:PointToObjectSpace(world_pos)
						local depth = -rel.Z
						if depth <= 0.05 then return nil end
						local tan_half = math.tan(math.rad(cam.FieldOfView) * 0.5)
						local aspect = vp.X / vp.Y
						local sx = ( rel.X / (depth * tan_half * aspect) * 0.5 + 0.5) * vp.X
						local sy = (-rel.Y / (depth * tan_half)          * 0.5 + 0.5) * vp.Y
						return vec2(sx, sy), depth
					end

					local function update_preview_box()
						local hrp = character and character.PrimaryPart
						local holder = cfg.objects.holder
						if not (hrp and holder) then return end
						local hpos = hrp.Position
						local w, h, cx, cy
						if flags["Box_Sizing"] == "Static" then
							local sp, depth = vp_project(hpos)
							if not sp then return end
							local sf = items.viewportframe.AbsoluteSize.Y
								/ (2 * depth * math.tan(math.rad(items.camera.FieldOfView) * 0.5))
							h = math.max(sf * (flags["Static_Box_Y"] or 5), 10)
							w = math.max(sf * (flags["Static_Box_X"] or 2.5), 8)
							cx, cy = sp.X, sp.Y
						else
							local up = hrp.CFrame.UpVector
							local spT = vp_project(hpos + up * 2)
							local spB = vp_project(hpos - up * 2.8)
							if not (spT and spB) then return end
							local raw_h = math.abs(spB.Y - spT.Y)
							if raw_h <= 0 then return end
							local pad = flags["Dynamic_Box_Padding"] or 1
							h  = raw_h * pad
							w  = (raw_h / 1.5) * pad
							cx = (spT.X + spB.X) * 0.5
							cy = math.min(spT.Y, spB.Y) + raw_h * 0.5
						end
						holder.Size = dim2(0, w, 0, h)
						holder.Position = dim2(0, cx, 0, cy)
					end

