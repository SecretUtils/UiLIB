							return
						end
						if GLOBAL_KEYS[key] then
							placed[key] = "on"; cfg._show[key] = true
							refresh_palette(); save_layout(); sync_real_flag(key, true)
							if cfg.refresh_elements then pcall(cfg.refresh_elements) end
							return
						end
						objects[key].Parent = containers[side]
						placed[key] = side
						sync_real_flag(key, true)
						if before_key and placed[before_key] == side then
							order[key] = (order[before_key] or 1) - 0.5
						else
							local mx = 0
							for k, s in pairs(placed) do if s == side and k ~= key then mx = math.max(mx, order[k] or 0) end end
							order[key] = mx + 1
						end
