							elseif d:IsA("BasePart") then
								d.Anchored = true
								d.CanCollide = false; d.CanQuery = false; d.CanTouch = false
								d.CastShadow = false
							end
						end

						local world = Instance.new("WorldModel")
						world.Parent = cell.vp
						clone.Parent = world

						local pivot, size
						if clone:IsA("Model") then
