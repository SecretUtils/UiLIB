							side = side or DEFAULT_BAR_SIDE[key] or "bottom"
							placed[key] = side; cfg._show[key] = true
							layout_bars_on_side(side)
							if old and old ~= side then layout_bars_on_side(old) end
							refresh_side_offsets()
							refresh_palette(); save_layout(); sync_real_flag(key, true)
