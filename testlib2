				do
					local saved = flags[cfg.flag]
					if type(saved) == "table" and saved.key ~= nil then
						cfg.key = saved.key
						cfg.mode = saved.mode or cfg.mode
						if type(saved.active) == "boolean" then cfg.active = saved.active end
