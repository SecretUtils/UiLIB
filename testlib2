			function library:load_config(config_json)
				local config = http_service:JSONDecode(config_json)

				local skip = library.skip_flags or {}
				local structural = {esp_layout = true, esp_layout_ai = true}

				local function apply(k, v)
					if skip[k] then return end
					local function_set = library.config_flags[k]

					if function_set then
						if type(v) == "table" and v["Transparency"] and v["Color"] then
							function_set(hex(v["Color"]), v["Transparency"])
						elseif type(v) == "table" and v["active"] then
							function_set(v)
						else
							function_set(v)
						end
					else
						if type(v) == "table" and v["Transparency"] and v["Color"] then
							flags[k] = {Color = hex(v["Color"]), Transparency = v["Transparency"]}
						elseif type(v) == "table" and v["key"] then
							local key = v["key"]
							if type(key) == "string" and key:find("Enum.", 1, true) then
								local ok, resolved = pcall(function() return library:convert_enum(key) end)
								key = (ok and resolved) or key
							end
							flags[k] = {mode = v["mode"], active = v["active"], key = key}
						else
							flags[k] = v
						end
					end
				end

				for k, v in next, config do
					if structural[k] then pcall(apply, k, v) end
				end
				for k, v in next, config do
					if not structural[k] then pcall(apply, k, v) end
				end
				if type(library.apply_saved_font) == "function" then
					pcall(function() library:apply_saved_font() end)
				end
			end

			function library:capture_ui_positions()
				if not library.ui_draggables then return end
				local out = {}
				for key, frame in pairs(library.ui_draggables) do
					if frame and frame.Parent then
						local ok, pos = pcall(function() return frame.Position end)
						local ok2, size = pcall(function() return frame.Size end)
						if ok then
							local entry = { pos.X.Offset, pos.Y.Offset }
							if ok2 then entry[3] = size.X.Offset; entry[4] = size.Y.Offset end
							out[key] = entry
						end
					end
				end
				flags["ui_positions"] = out
			end
			library.config_flags["ui_positions"] = function(v)
				if type(v) ~= "table" then return end
				flags["ui_positions"] = v
				if not library.ui_draggables then return end
				for key, pos in pairs(v) do
					local frame = library.ui_draggables[key]
					if frame and frame.Parent and type(pos) == "table" then
						local x, y = tonumber(pos[1]), tonumber(pos[2])
						if x and y then pcall(function() frame.Position = dim2(0, x, 0, y) end) end
						local w, h = tonumber(pos[3]), tonumber(pos[4])
						if w and h then pcall(function() frame.Size = dim2(0, w, 0, h) end) end
					end
				end
			end

