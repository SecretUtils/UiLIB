					if type(v) ~= "table" then return end
					table.clear(library.playerlist_saved)
					for k, val in pairs(v) do
						if type(k) == "string" and type(val) == "string" then library.playerlist_saved[k] = val end
					end
					library.apply_saved_playerlist()
				end

