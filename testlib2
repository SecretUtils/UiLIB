					library:connection(vp.InputBegan, function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1
							or input.UserInputType == Enum.UserInputType.Touch then
							vp_drag = true; vp_dragx = input.Position.X; vp_dragrot = vp_rot
							vp_dragy = input.Position.Y; vp_dragpitch = vp_pitch
