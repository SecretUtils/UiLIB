					for name, path in pairs(library.playerlist_data) do
						if type(name) == "string" and type(path) == "table" and path.priority_text and name ~= lp.Name then
							local saved = library.playerlist_saved[name]
							if saved and patterns[saved] then
								path.priority = saved
								path.priority_text.Text = saved
								path.priority_text.TextColor3 = patterns[saved]
							end
						end
					end
				end

