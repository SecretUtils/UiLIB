							local bb; bb, size = clone:GetBoundingBox(); centre = bb.Position
						elseif clone:IsA("BasePart") then
							centre, size = clone.Position, clone.Size
						else
							world:Destroy(); error("not a model")
						end
						if size.Magnitude < 0.1 then size = vec3(2, 2, 2) end
						clone:PivotTo(clone:GetPivot() - centre)

						local cam = Instance.new("Camera")
						cam.FieldOfView = 40
						cam.Parent = vp
						vp.CurrentCamera = cam
						local dist = (size.Magnitude * 0.5) / tan(rad(cam.FieldOfView * 0.5)) * 1.25
						cam.CFrame = CFrame.lookAt(vec3(1, 0.45, 1).Unit * dist, vec3())

