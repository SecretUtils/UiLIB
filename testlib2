			--// background snowfall, ported from nhack's SetupBackgroundEffects.
			--// `open` is driven by window.set_menu_visibility, so closing the menu stops
			--// the spawner AND clears the flakes already in flight - snow must never keep
			--// falling over the game with the UI hidden.
			library.snow = {
				enabled = false,
				open    = false,
				color   = rgb(255, 255, 255),
				glow    = false,
				glow_color = rgb(120, 170, 255),
				glow_size  = 3,
				amount  = 10,
				asset   = "http://www.roblox.com/asset/?id=6871196088",
			}

			function library:setup_snow()
				if library._snow_holder then return end

				--// NEGATIVE DisplayOrder. library:panel leaves its ScreenGui at the default 0,
				--// and draggify bumps a dragged panel up from there, so anything >= 0 puts snow
				--// on top of the Style / Playerlist / Output windows.
				--// library:create registers it in library.guis, so "Unload Menu" destroys it.
				local snow_gui = library:create("ScreenGui", {
					Enabled = true,
					Parent = gethui(),
					Name = "",
					IgnoreGuiInset = true,
					DisplayOrder = -1000,
				})

				local holder = library:create("Frame", {
					Parent = snow_gui,
					Name = "",
					BackgroundTransparency = 1,
					BorderColor3 = rgb(0, 0, 0),
					BorderSizePixel = 0,
					ClipsDescendants = true,
					Position = dim2(0, 0, 0, 0),
					Size = dim2(1, 0, 1, 0),
					ZIndex = 0,
					BackgroundColor3 = rgb(255, 255, 255)
				})

				library._snow_gui, library._snow_holder = snow_gui, holder

				task.spawn(function()
					while library._snow_holder do
						local s = library.snow

						if not (s.enabled and s.open) then
							task.wait(0.15)
						else
							local w, h = holder.AbsoluteSize.X, holder.AbsoluteSize.Y
							if w <= 0 or h <= 0 then
								task.wait(0.15)
							else
								local size  = random(5, 8)
								local spawn = random(0, max(0, floor(w - size)))

								local flake = library:create("ImageLabel", {
									Parent = holder,
									Name = "",
									BackgroundTransparency = 1,
									BorderColor3 = rgb(0, 0, 0),
									BorderSizePixel = 0,
									Image = s.asset,
									ImageColor3 = s.color,
									Size = dim2(0, size, 0, size),
									Position = dim2(0, spawn, 0, -10),
									ZIndex = 0,
									BackgroundColor3 = rgb(255, 255, 255)
								})

								--// the glow is a soft oversized copy behind the flake. it is a
								--// CHILD, so the fall tween on the parent carries it along and
								--// only one tween per flake is ever created.
								if s.glow then
									local g = s.glow_size
									library:create("ImageLabel", {
										Parent = flake,
										Name = "",
										BackgroundTransparency = 1,
										BorderColor3 = rgb(0, 0, 0),
										BorderSizePixel = 0,
										Image = s.asset,
										ImageColor3 = s.glow_color,
										ImageTransparency = 0.72,
										AnchorPoint = vec2(0.5, 0.5),
										Position = dim2(0.5, 0, 0.5, 0),
										Size = dim2(g, 0, g, 0),
										ZIndex = 0,
										BackgroundColor3 = rgb(255, 255, 255)
									})
								end

								local fall = random(20, 40) / 10
								local sway = random(-18, 18)

								local tween = tween_service:Create(flake,
									TweenInfo.new(fall, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
										Position = dim2(0, spawn + sway, 0, h + 10),
										ImageTransparency = 1
									})

								tween.Completed:Connect(function()
									if flake and flake.Parent then flake:Destroy() end
								end)
								tween:Play()

								--// amount 1..30 -> roughly one flake every 0.30s .. 0.03s
								task.wait(math.clamp(1 / max(1, s.amount), 0.03, 0.3))
							end
						end
					end
				end)
			end

