							or input.UserInputType == Enum.UserInputType.Touch) then
							vp_rot = vp_dragrot + (input.Position.X - vp_dragx) * 0.6
							vp_pitch = math.clamp(vp_dragpitch + (input.Position.Y - vp_dragy) * 0.6, -85, 85)
						end
					end)
					library:connection(uis.InputEnded, function(input)
