			function library:get_config()
				if type(library.capture_ui_positions) == "function" then
					pcall(function() library:capture_ui_positions() end)
				end
				local Config = {}

				local skip = library.skip_flags or {}

				for _, v in flags do
					if skip[_] then
					elseif type(v) == "table" and v.key then
						Config[_] = {active = v.active, mode = v.mode, key = tostring(v.key)}
					elseif type(v) == "table" and v["Transparency"] and v["Color"] then
						Config[_] = {Transparency = v["Transparency"], Color = v["Color"]:ToHex()}
					elseif type(v) == "table" or type(v) == "string" or type(v) == "boolean" then
						Config[_] = v
					elseif type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
						Config[_] = v
					end
				end

				return http_service:JSONEncode(Config)
