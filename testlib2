			function library:anchor_popup(frame, anchor, align_right)
				if not (frame and anchor and frame.Parent and anchor.Parent) then return end
				local ap, asz = anchor.AbsolutePosition, anchor.AbsoluteSize
				local psz = frame.AbsoluteSize
				local root = frame.Parent
				local vp = (root and root.AbsoluteSize) or vec2(1920, 1080)
				local gap = 2

				local ins = 0
				local sg = frame:FindFirstAncestorWhichIsA("ScreenGui")
				if sg and sg.IgnoreGuiInset then ins = gui_service:GetGuiInset().Y end
				local ax, ay = ap.X, ap.Y + ins

				local x = align_right and (ax + asz.X - psz.X) or ax
				if psz.X > 0 then x = clamp(x, 0, max(0, vp.X - psz.X)) end

				local below = ay + asz.Y + gap
				if psz.Y <= 0 or below + psz.Y <= vp.Y then
					frame.Position = dim2(0, x, 0, below)
					return
				end
				local above = ay - psz.Y - gap
				if above >= 0 then
					frame.Position = dim2(0, x, 0, above)
					return
				end
				local y = clamp(ay, 0, max(0, vp.Y - psz.Y))
				local right = ax + asz.X + gap
				if right + psz.X <= vp.X then
					frame.Position = dim2(0, right, 0, y)
				else
					frame.Position = dim2(0, max(0, ax - psz.X - gap), 0, y)
				end
			end

			function library:track_popup(frame, anchor, align_right)
				library.tracked_popup = frame and {frame = frame, anchor = anchor, right = align_right} or nil
				if frame then library:anchor_popup(frame, anchor, align_right) end
			end

